# ===================== Database =====================
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=Woffo_db
MYSQL_USER=Woffo_db_user
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# ===================== Redis =====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================== Kafka =====================
KAFKA_HOST=kafka
KAFKA_PORT=9092

# ===================== MinIO =====================
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=wofuf-images

# ===================== Eureka (Distributed Mode) =====================
EUREKA_HOST=wofuf-discovery
EUREKA_PORT=8761

# ===================== Service Ports (Distributed Mode) =====================
USERS_PORT=8001
PLAYERS_PORT=8002
FORUM_PORT=8003
GATEWAY_PORT=9999
DISCOVERY_PORT=8761

# ===================== JWT =====================
# IMPORTANT: Change this to a strong secret in production!
JWT_SECRET=your-secret-key-must-be-at-least-32-bytes-long-and-secure!
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER=auth-service
JWT_CLOCK_SKEW=60

# ===================== Spring =====================
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update
DB_MAX_POOL=10
DB_MIN_IDLE=5

# ===================== Security =====================
SECURITY_USER=saraki
SECURITY_PASSWORD=saraki

# ===================== Module Secrets =====================
PLAYERS_SECRET_KEY=secretKey
FORUM_SECRET_KEY=This is a secret key that only the server and the client know.

# ===================== Plugin =====================
PLUGIN_API_BASE_URL=http://127.0.0.1:8080
SKIN_BACKUP_URL=https://littleskin.cn/skin

# ===================== Frontend =====================
FRONTEND_PORT=80
BACKEND_PORT=8005

# ===================== External Access Ports =====================
MYSQL_EXTERNAL_PORT=3307
REDIS_EXTERNAL_PORT=6380
KAFKA_EXTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
MINIO_EXTERNAL_PORT=9000
MINIO_EXTERNAL_CONSOLE_PORT=9001
