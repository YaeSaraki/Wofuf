%% Wofuf 前端架构图
%% Vue 3 + TypeScript + Vite + PrimeVue + Tailwind CSS

flowchart TD
%% ===== Views =====
    subgraph Views["视图层 (Views)"]
        HomeView["首页视图\nHomeView.vue"]
        PlayerView["玩家视图\nPlayerView.vue"]
        ForumView["论坛视图\nForumView.vue"]
        AuthView["认证视图\nLoginView/RegisterView"]
    end

%% ===== Modules =====
    subgraph Modules["业务模块 (Modules)"]
        AuthModule["认证模块\n- components/\n- services/\n- stores/"]
        PlayersModule["玩家模块\n- components/\n- services/\n- dtos/"]
        ForumModule["论坛模块\n- components/\n- services/\n- dtos/"]
    end

%% ===== Shared =====
    subgraph Shared["共享层 (Shared)"]
        Components["通用组件\n- Button/\n- Modal/\n- Card/"]
        Services["服务层\n- api/ (HTTP 客户端)\n- auth/\n- i18n/"]
        Composables["组合函数\n- useAsyncLoader/\n- useAuth/"]
        Utils["工具函数\n- format/\n- validate/"]
        Layout["布局组件\n- Header/\n- Footer/\n- Sidebar/"]
        Assets["静态资源\n- images/\n- styles/\n- icons/"]
    end

%% ===== External =====
    subgraph External["外部依赖"]
        PrimeVue["PrimeVue UI\n- 组件库\n- 图标库"]
        Tailwind["Tailwind CSS\n- 原子化 CSS"]
        VueRouter["Vue Router\n- 路由管理"]
        Pinia["Pinia (可选)\n- 状态管理"]
    end

%% ===== Connections =====
    HomeView --> AuthModule
    HomeView --> PlayersModule
    HomeView --> ForumModule
    PlayerView --> PlayersModule
    ForumView --> ForumModule
    AuthView --> AuthModule
    AuthModule --> Services
    PlayersModule --> Services
    ForumModule --> Services
    Services --> Components
    Components --> Utils
    AuthModule --> Composables
    PlayersModule --> Composables
    ForumModule --> Composables
    Views --> Layout
    Layout --> Components
    Components --> PrimeVue
    Components --> Tailwind
    Views --> VueRouter
