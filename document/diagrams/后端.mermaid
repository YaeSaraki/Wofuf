%% Wofuf 后端架构图
%% Domain-Driven Design (DDD) 分层架构

flowchart TB
%% ===== 服务模块 =====
    subgraph Players["玩家服务 (Players)"]
        P_Domain["领域层 (domain)"]
        P_Entity["Player (实体)\nAggregateRoot<PlayerProps>"]
        P_Value["值对象\nPlayerId\nPlayerName\nPlayerSkin"]
        P_Event["领域事件"]
        
        P_UseCases["用例层 (useCases)"]
        P_GetPlayer["GetPlayerUseCase\n获取玩家数据"]
        P_GetStats["GetPlayerStatisticsUseCase\n获取统计"]
        P_Search["SearchPlayerUseCase\n搜索玩家"]
    end
    
    subgraph Users["用户服务 (Users)"]
        U_Domain["领域层 (domain)"]
        U_Entity["User (实体)\nAggregateRoot<UserProps>"]
        U_Value["值对象\nUserId\nUsername"]
        U_Event["领域事件\nUserCreated\nUserLoggedIn"]
        
        U_UseCases["用例层 (useCases)"]
        U_Login["LoginUseCase\n用户登录"]
        U_Register["RegisterUserUseCase\n用户注册"]
        U_Refresh["RefreshAccessTokenUseCase\n刷新令牌"]
    end
    
    subgraph Forum["论坛服务 (Forum)"]
        F_Domain["领域层 (domain)"]
        F_Entity["Post (帖子)\nAggregateRoot<PostProps>"]
        F_Entity["Comment (评论)\nAggregateRoot<CommentProps>"]
        F_Value["值对象\nPostId\nPostSlug\nCommentId"]
        F_Event["领域事件\nPostCreated\nCommentCreated"]
        
        F_UseCases["用例层 (useCases)"]
        F_CreatePost["CreatePostUseCase\n创建帖子"]
        F_AddComment["AddCommentUseCase\n添加评论"]
        F_GetPosts["GetPostsUseCase\n获取帖子列表"]
        F_Upvote["UpvotePostUseCase\n点赞帖子"]
    end
    
%% ===== 基础设施层 =====
    subgraph Infra["基础设施层 (Infrastructure)"]
        I_Repo["仓储接口 (Repository)\n- PlayerRepo\n- UserRepository\n- PostRepo"]
        JPA["JPA Repository\n- PlayerJpaRepo\n- UserJpaRepo\n- PostJpaRepo"]
        Redis["Redis 缓存\n- Database 0: Auth (令牌)\n- Database 1: Players (玩家)"]
        MySQL["MySQL 数据库\n- PlayerDB (玩家库)\n- UserDB (用户库)\n- ForumDB (论坛库)"]
        Kafka["Kafka 消息队列\n- Eventuate Tram\n- domain-events-topic"]
    end

    subgraph External["外部系统集成"]
        MeovoPlugin["Meovo 插件\n数据采集"]
        MinecraftServer["Minecraft 服务器"]
    end

%% ===== 数据流 =====
    MeovoPlugin -->|采集数据| P_Scheduler["定时任务"]
    P_Scheduler -->|写入| MySQL_Player
    P_Scheduler -->|缓存| Redis
    
    Browser -->|API 请求| Gateway
    Gateway -->|认证| U_Login
    Gateway -->|数据查询| P_GetPlayer
    Gateway -->|数据查询| P_GetPosts
    Gateway -->|数据查询| F_GetPosts
    
    U_Login -->|验证凭据| U_Entity
    U_Login -->|生成令牌| U_JwtService["JWT 服务"]
    U_Login -->|返回令牌| Browser
    
    P_GetPlayer -->|查询| I_Repo
    P_GetPlayer -->|查询| JPA
    P_GetPlayer -->|缓存检查| Redis
    P_GetPlayer -->|数据库查询| MySQL_Player
    P_GetPlayer -->|返回数据| P_Entity
    P_GetPlayer -->|转换| P_Dto
    P_GetPlayer -->|返回响应| Browser
    
    F_CreatePost -->|创建领域| F_Entity
    F_CreatePost -->|保存| I_Repo
    F_CreatePost -->|保存| JPA
    F_CreatePost -->|持久化| MySQL_Forum
    F_CreatePost -->|发布事件| Kafka
    
    F_CreatePost -->|返回响应| Browser
    
%% ===== 共享模块 =====
    subgraph Shared["共享模块 (Shared)"]
        SharedCore["shared-core\n- Result\n- UseCase\n- Guard"]
        SharedAuth["shared-auth\n- JWT 工具\n- 认证装饰器"]
    end
    
    PS_Domain --> SharedCore
    PS_Domain --> SharedAuth
    U_Domain --> SharedCore
    U_Domain --> SharedAuth
    F_Domain --> SharedCore
