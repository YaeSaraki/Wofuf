graph LR
%% 定义样式（可选，增强可读性）


%% 基础模块
    BASE[基础模块]:::base --> GET_API_ROOT["GET /api/v1/
    功能：API根路径
    响应：ApiResponse&lt;String&gt;"]

%% 用户模块
USER[用户模块]:::user --> POST_CREATE_USER["POST /api/v1/users
    功能：创建新用户
    参数：CreateUserDto
    响应：ApiResponse&lt;String&gt;"]
USER --> DELETE_USER["DELETE /api/v1/users/{userId}
    功能：删除用户
    参数：路径参数userId / Header: MeoKey
    响应：ApiResponse&lt;String&gt;"]
USER --> GET_USER_BY_USERNAME["GET /api/v1/users/username/{username}
    功能：按用户名查用户
    参数：路径参数username
    响应：用户详细信息"]
USER --> GET_USER_ME["GET /api/v1/users/me
    功能：获取当前用户信息
    参数：Header: MeoKey
    响应：当前用户详细信息"]
USER --> POST_LOGIN["POST /api/v1/users/me/sessions
    功能：用户登录
    参数：LoginDto(用户名/密码)
    响应：LoginResponse(令牌)"]
USER --> DELETE_LOGOUT["DELETE /api/v1/users/me/sessions
    功能：用户登出
    参数：Header: MeoKey
    响应：LogoutResponse"]
USER --> POST_REFRESH["POST /api/v1/users/me/tokens
    功能：刷新令牌
    参数：RefreshAccessTokenDto
    响应：新访问令牌"]

%% 玩家模块
PLAYER[玩家模块]:::player --> GET_PLAYER["GET /api/v1/players/playerNameOrUuid/{playerNameOrUuid}
    功能：获取玩家资料
    参数：路径参数playerNameOrUuid
    响应：GetPlayerView(玩家资料)"]
PLAYER --> GET_PLAYER_STAT["GET /api/v1/players/statistics/{playerUuid}
    功能：获取玩家统计数据
    参数：路径参数playerUuid + 可选查询参数(category/categories/key/keys)
    响应：GetPlayerStatisticsView"]
PLAYER --> GET_PLAYER_ADV["GET /api/v1/players/advancements/{playerUuid}
    功能：获取玩家成就
    参数：路径参数playerUuid + 可选查询参数includeRecipes
    响应：GetPlayerAdvancementsView"]
PLAYER --> GET_PLAYER_SKIN["GET /api/v1/players/skins/{playerUuid}
    功能：获取玩家皮肤
    参数：路径参数playerUuid
    响应：玩家皮肤信息"]
PLAYER --> GET_PLAYER_YESTERDAY["GET /api/v1/players/yesterday
    功能：获取昨日在线玩家列表
    参数：无
    响应：昨日在线玩家列表"]
PLAYER --> GET_PLAYER_RANDOM["GET /api/v1/players/random-profile
    功能：获取随机玩家资料
    参数：可选查询参数count(默认1)
    响应：随机玩家资料列表"]
PLAYER --> GET_PLAYER_SEARCH["GET /api/v1/players/search
    功能：搜索玩家
    参数：查询参数query + 可选limit(默认20)
    响应：玩家搜索结果列表"]

%% 论坛模块 - 成员
FORUM[论坛模块]:::forum --> FORUM_MEMBER[成员]:::member
FORUM_MEMBER --> POST_CREATE_MEMBER["POST /api/v1/forum/members
    功能：创建论坛成员
    响应：成员信息"]
FORUM_MEMBER --> GET_CURRENT_MEMBER["GET /api/v1/forum/members/current
    功能：获取当前论坛成员
    参数：Header: userId
    响应：当前成员信息"]
FORUM_MEMBER --> GET_MEMBER_BY_USERNAME["GET /api/v1/forum/members/username/{username}
    功能：按用户名查论坛成员
    参数：路径参数username
    响应：成员信息"]

%% 论坛模块 - 帖子
FORUM --> FORUM_POST[帖子]:::post
FORUM_POST --> POST_CREATE_POST["POST /api/v1/forum/posts
    功能：创建帖子
    响应：帖子信息"]
FORUM_POST --> GET_POST_BY_SLUG["GET /api/v1/forum/posts/slug/{postSlug}
    功能：按slug获取帖子
    参数：路径参数postSlug + 可选查询参数userId
    响应：帖子详情"]
FORUM_POST --> PUT_EDIT_POST["PUT /api/v1/forum/posts/{postId}
    功能：编辑帖子
    参数：路径参数postId
    响应：更新后的帖子"]
FORUM_POST --> DELETE_POST["DELETE /api/v1/forum/posts/{postId}
    功能：删除帖子
    参数：路径参数postId
    响应：ApiResponse"]
FORUM_POST --> PUT_UPVOTE_POST["PUT /api/v1/forum/posts/{postId}/upvote
    功能：帖子点赞
    参数：路径参数postId
    响应：投票结果"]
FORUM_POST --> PUT_DOWNVOTE_POST["PUT /api/v1/forum/posts/{postId}/downvote
    功能：帖子点踩
    参数：路径参数postId
    响应：投票结果"]
FORUM_POST --> PUT_UNVOTE_POST["PUT /api/v1/forum/posts/{postId}/unvote
    功能：取消帖子投票
    参数：路径参数postId
    响应：投票结果"]
FORUM_POST --> GET_POPULAR_POSTS["GET /api/v1/forum/posts/popular
    功能：获取热门帖子
    参数：可选查询参数page/size/userId/category
    响应：帖子列表(分页)"]
FORUM_POST --> GET_RECENT_POSTS["GET /api/v1/forum/posts/recent
    功能：获取最新帖子
    参数：可选查询参数page/size/userId/category
    响应：帖子列表(分页)"]

%% 论坛模块 - 评论
FORUM --> FORUM_COMMENT[评论]:::comment
FORUM_COMMENT --> GET_COMMENT_BY_ID["GET /api/v1/forum/comments/{commentId}
    功能：按ID获取评论
    参数：路径参数commentId + 可选查询参数userId
    响应：评论详情"]
FORUM_COMMENT --> GET_COMMENTS_BY_SLUG["GET /api/v1/forum/posts/slug/{postSlug}/comments
    功能：按帖子slug获取评论列表
    参数：路径参数postSlug
    响应：评论列表"]
FORUM_COMMENT --> PUT_COMMENT_STATS["PUT /api/v1/forum/comments/{commentId}/stats
    功能：更新评论统计
    参数：路径参数commentId
    响应：更新后的统计"]
FORUM_COMMENT --> PUT_UPVOTE_COMMENT["PUT /api/v1/forum/comments/{commentId}/upvote
    功能：评论点赞
    参数：路径参数commentId
    响应：投票结果"]
FORUM_COMMENT --> PUT_DOWNVOTE_COMMENT["PUT /api/v1/forum/comments/{commentId}/downvote
    功能：评论点踩
    参数：路径参数commentId
    响应：投票结果"]
FORUM_COMMENT --> POST_REPLY_COMMENT["POST /api/v1/forum/comments/{commentId}/replies
    功能：回复评论
    参数：路径参数commentId
    响应：回复内容"]
FORUM_COMMENT --> POST_REPLY_POST["POST /api/v1/forum/posts/{postId}/replies
    功能：回复帖子
    参数：路径参数postId
    响应：回复内容"]
FORUM_COMMENT --> POST_REPLY_POST_SLUG["POST /api/v1/forum/posts/slug/{postSlug}/replies
    功能：按slug回复帖子
    参数：路径参数postSlug
    响应：回复内容"]

%% 论坛模块 - 图片
FORUM --> FORUM_IMAGE[图片]:::image
FORUM_IMAGE --> POST_UPLOAD_IMAGE["POST /api/v1/forum/images/upload
    功能：上传图片
    参数：multipart/form-data(file, folder)
    响应：图片信息"]
