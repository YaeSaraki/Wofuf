flowchart TD
    subgraph 接口层Interface Layer
        Controllers["REST API控制器\n- Routes.kt (路由分发器)\n- *Routes.kt (如StatisticRoutes.kt)"]
        DTOs["数据传输对象\n- StatisticResult\n- AdvancementResult\n- PlayerResult"]
    end

    subgraph 应用层Application Layer
        UseCases["用例层\n- StatisticQueryService\n- AdvancementQueryService\n- PlayerQueryService"]
        Commands["命令/查询对象\n- StatisticQuery\n- AdvancementQuery\n- PlayerQuery"]
        Items["数据项对象\n- StatisticItem\n- AdvancementItem"]
    end

    subgraph 领域层Domain Layer
        Repositories["仓储接口\n- StatisticReader\n- AdvancementReader\n- PlayerReader"]
        Aggregates["聚合根\n- 玩家统计信息\n- 玩家成就\n- 玩家基本信息"]
    end

    subgraph 基础设施层Infrastructure Layer
        Persistence["持久化实现\n- BukkitStatisticReader\n- BukkitAdvancementReader\n- BukkitPlayerReader"]
        ExternalServices["外部服务\n- Bukkit API集成\n- Minecraft统计系统"]
        Config["配置管理\n- YaWebApiConfig"]
    end

    subgraph 核心模块Core Module
        WebServer["HTTP服务器\n- WebServer.kt\n- NanoHTTPD实现"]
        Module["模块入口\n- YaWebApiModule.kt\n- 生命周期管理"]
        SharedUtils["共享工具\n- RouteUtils.kt\n- JSON处理\n- CORS支持"]
    end

%% 接口层数据流
    Controllers --> DTOs
    Controllers --> UseCases
%% 应用层数据流
    UseCases --> Commands
    UseCases --> Items
    UseCases --> Repositories
%% 领域层数据流
    Repositories --> Aggregates
%% 基础设施层数据流
    Persistence --> Repositories
    ExternalServices --> Persistence
    Config --> UseCases
    Config --> Controllers
%% 核心模块数据流
    Module --> WebServer
    WebServer --> Controllers
    SharedUtils --> Controllers
    SharedUtils --> UseCases